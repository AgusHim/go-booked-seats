POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=ticketing
DATABASE_URL=postgres://ticketing:change-this-postgres-password@postgres:5432/ticketing?sslmode=disable

REDIS_URL=redis:6379
REDIS_PASSWORD=change-this-redis-password

JWT_SECRET=change-this-to-a-random-secret-at-least-24-chars
REQUIRE_JWT_SECRET=true
REQUIRE_VERIFIED_EMAIL=false
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example

# Local development only. Connect an email delivery adapter before enabling
# REQUIRE_VERIFIED_EMAIL in staging/production.
# AUTH_TOKEN_DELIVERY=development_response

# Legacy only; DATABASE_URL takes precedence when both are set.
# POSTGRE_URL=
